{
  "name": "leptonweb",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "LeptonWeb is a paid knowledge network for AI agents. The first wedge is Tollgate: an answer engine that pays creators per cited source and writes attribution receipts.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm --prefix ../pay-per-piece run build",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "npm --prefix ../pay-per-piece run build",
    "typecheck": "tsc --noEmit",
    "sync:wordpress-zip": "node scripts/sync-wordpress-zip.mjs",
    "pretest": "npm --prefix ../pay-per-piece run build",
    "test": "vitest run",
    "bench": "vite-node bench/run.ts",
    "refetch:content": "node scripts/refetch-source-content.mjs",
    "verify:ledger": "node scripts/verify-ledger.mjs",
    "judge:verify": "node scripts/judge-verify.mjs",
    "deploy:use-intent": "node scripts/deploy-use-receipt-registry.mjs",
    "test:use-intent-contract": "node scripts/test-use-receipt-registry.mjs",
    "deploy:pay-gate": "node scripts/deploy-pay-gate.mjs",
    "test:pay-gate-contract": "node scripts/test-pay-gate.mjs",
    "migrate:ledger": "node scripts/migrate-ledger.mjs",
    "discover:sources": "node ../scripts/discover-sources.mjs --write",
    "export:proof-pack": "node scripts/export-proof-pack.mjs",
    "prove:x402": "node scripts/prove-x402-source.mjs",
    "prove:paid-query": "node scripts/prove-paid-query.mjs",
    "prove:wallet-source": "node scripts/prove-wallet-source.mjs",
    "prove:wallet-paid-query": "node scripts/prove-wallet-paid-query.mjs",
    "prove:w3s-source": "node --env-file-if-exists=.env.local scripts/prove-w3s-source.mjs",
    "prove:w3s-paid-query": "node --env-file-if-exists=.env.local scripts/prove-w3s-paid-query.mjs",
    "prove:settled-paid-query": "node scripts/prove-settled-paid-query.mjs",
    "prove:gateway-source": "node scripts/prove-gateway-source.mjs",
    "prove:fee-router": "node scripts/prove-fee-router.mjs",
    "prove:fee-router-query": "node scripts/prove-fee-router-query.mjs",
    "prove:fee-router-claim": "node scripts/prove-fee-router-claim.mjs",
    "prove:track-record": "node scripts/prove-track-record.mjs",
    "prove:covenant": "node scripts/prove-covenant-envelope.mjs",
    "prove:slashbond": "node scripts/prove-slashbond-status.mjs",
    "prove:slashbond-demo": "node scripts/prove-demo-slashbond.mjs",
    "run:demand-engine": "node scripts/demand-engine.mjs",
    "seed:judge-demo": "node scripts/seed-judge-demo.mjs",
    "check:facilitator": "node scripts/check-facilitator.mjs",
    "check:forum": "node scripts/check-forum.mjs",
    "check:wallet-funding": "node scripts/check-wallet-funding.mjs",
    "create:wallets": "node scripts/create-wallets.mjs",
    "create:circle-wallets": "node --env-file-if-exists=.env.local scripts/circle-create-wallets.mjs",
    "wallets:list": "node scripts/list-wallets.mjs",
    "start:settle-server": "node scripts/start-settle-server.mjs",
    "start:gateway-server": "node scripts/start-gateway-server.mjs"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.2.0",
    "@x402/core": "^2.17.0",
    "@x402/evm": "^2.17.0",
    "@x402/fetch": "^2.17.0",
    "buffer": "^6.0.3",
    "fast-xml-parser": "^5.9.3",
    "next": "^15.5.4",
    "nodemailer": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solc": "^0.8.35",
    "tollgate-pay-per-piece": "file:../pay-per-piece",
    "undici": "6.27.0",
    "viem": "^2.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.15",
    "tmp": "0.2.7",
    "ws": "8.21.0"
  }
}
